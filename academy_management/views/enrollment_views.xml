<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- Enrollment List View -->
    <record id="view_academy_enrollment_list" model="ir.ui.view">
        <field name="name">academy.enrollment.list</field>
        <field name="model">academy.enrollment</field>
        <field name="arch" type="xml">

            <list string="Enrollments">
                <field name="student_id"/>
                <field name="course_id"/>
                <field name="batch_id"/>
                <field name="enrollment_date"/>
                <field name="fees"/>
                <field name="paid"/>
                <field name="remaining"/>
                <field name="state"/>
            </list>

        </field>
    </record>


    <!-- Enrollment Form View -->
    <record id="view_academy_enrollment_form" model="ir.ui.view">
        <field name="name">academy.enrollment.form</field>
        <field name="model">academy.enrollment</field>
        <field name="arch" type="xml">

            <form string="Enrollment">

             

                <sheet>

                    <group>
                        <group>
                            <field name="student_id"/>
                            <field name="course_id"/>
                            <field name="batch_id"/>
                            <field name="enrollment_date"/>
                        </group>

                       <!--  <group>
                            <field name="course_fees" readonly="1"/>
                            <field name="batch_name" readonly="1"/>
                            <field name="trainer_name" readonly="1"/>
                        </group> -->
                    </group>

                    <group string="Fees">
                        <field name="fees"/>
                        <field name="paid"/>
                        <field name="remaining"/>
                    </group>

                </sheet>

            </form>

        </field>
    </record>


    <!-- Enrollment Calendar View -->
    <record id="view_academy_enrollment_calendar" model="ir.ui.view">
        <field name="name">academy.enrollment.calendar</field>
        <field name="model">academy.enrollment</field>
        <field name="arch" type="xml">

            <calendar
                string="Enrollments"
                date_start="enrollment_date"
                color="state">

                <field name="student_id"/>
                <field name="course_id"/>
                <field name="batch_id"/>
                <field name="state"/>

            </calendar>

        </field>
    </record>


    <!-- Enrollment Action -->
    <record id="action_academy_enrollment" model="ir.actions.act_window">
        <field name="name">Enrollments</field>
        <field name="res_model">academy.enrollment</field>
        <field name="view_mode">list,calendar,form</field>
    </record>


    <!-- Enrollment Menu -->
    <menuitem
        id="menu_academy_enrollment"
        name="Enrollments"
        parent="menu_academy_management_root"
        action="action_academy_enrollment"
        sequence="40"
    />

</odoo>

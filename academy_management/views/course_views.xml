<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- Course List View -->
    <record id="view_academy_course_list" model="ir.ui.view">
        <field name="name">academy.course.list</field>
        <field name="model">academy.course</field>
        <field name="arch" type="xml">
            <list string="Courses">
                <field name="name"/>
                <field name="course_code"/>
                <field name="course_fees"/>
                <field name="duration"/>
                <field name="total_students"/>
                <field name="active"/>
            </list>
        </field>
    </record>


    <!-- Course Form View -->
    <record id="view_academy_course_form" model="ir.ui.view">
        <field name="name">academy.course.form</field>
        <field name="model">academy.course</field>
        <field name="arch" type="xml">
            <form string="Course">

                <sheet>

                    <group>
                        <group>
                            <field name="name"/>
                            <field name="course_code"/>
                            <field name="course_fees"/>
                        </group>

                        <group>
                            <field name="duration"/>
                            <field name="total_students" readonly="1"/>
                            <field name="active"/>
                        </group>
                    </group>

                    <notebook>

                        <page string="Description">
                            <field name="description"/>
                        </page>

                    </notebook>

                </sheet>

            </form>
        </field>
    </record>


    <!-- Course Action -->
    <record id="action_academy_course" model="ir.actions.act_window">
        <field name="name">Courses</field>
        <field name="res_model">academy.course</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- Root Menu -->
    <menuitem
        id="menu_academy_management_root"
        name="Academy Management"
        sequence="10"/>


    <!-- Course Menu -->
    <menuitem
        id="menu_academy_course"
        name="Courses"
        parent="menu_academy_management_root"
        action="action_academy_course"
        sequence="10"/>

</odoo>
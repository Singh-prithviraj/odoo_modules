<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- Batch List View -->
    <record id="view_academy_batch_list" model="ir.ui.view">
        <field name="name">academy.batch.list</field>
        <field name="model">academy.batch</field>
        <field name="arch" type="xml">
            <list string="Batches">
                <field name="name"/>
                <field name="course_id"/>
                <field name="trainer_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="capacity"/>
                <field name="current_students"/>
                <field name="available_seats"/>
                <field name="status"/>
            </list>
        </field>
    </record>


    <!-- Batch Form View -->
    <record id="view_academy_batch_form" model="ir.ui.view">
        <field name="name">academy.batch.form</field>
        <field name="model">academy.batch</field>
        <field name="arch" type="xml">
            <form string="Batch">

                <sheet>

                    <group>

                        <group>
                            <field name="name"/>
                            <field name="course_id"/>
                            <field name="course_name" readonly="1"/>
                            <field name="course_fees" readonly="1"/>
                            <field name="trainer_id"/>
                            <field name="status"/>
                        </group>

                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="capacity"/>
                            <field name="current_students"
                                   readonly="1"/>
                            <field name="available_seats"
                                   readonly="1"/>
                        </group>

                    </group>

                </sheet>

            </form>
        </field>
    </record>


    <!-- Batch Action -->
    <record id="action_academy_batch" model="ir.actions.act_window">
        <field name="name">Batches</field>
        <field name="res_model">academy.batch</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- Batch Menu -->
    <menuitem
        id="menu_academy_batch"
        name="Batches"
        parent="menu_academy_management_root"
        action="action_academy_batch"
        sequence="20"/>

</odoo>
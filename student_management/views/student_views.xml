<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- Student List View -->
    <record id="student_student_list_view" model="ir.ui.view">

        <field name="name">student.student.list</field>

        <field name="model">student.student</field>

        <field name="arch" type="xml">

            <list>

                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="age"/>
                <field name="gender"/>
                <field name="course_id"/>

            </list>

        </field>

    </record>


    <!-- Student Form View -->
    <record id="student_student_form_view" model="ir.ui.view">

        <field name="name">student.student.form</field>

        <field name="model">student.student</field>

        <field name="arch" type="xml">

            <form>

                <sheet>

                    <group>

                        <field name="name"/>
                        <field name="email"/>
                        <field name="phone"/>
                        <field name="age"/>
                        <field name="gender"/>
                        <field name="course_id"/>

                    </group>

                </sheet>

            </form>

        </field>

    </record>


    <!-- Student Action -->
    <record id="student_student_action" model="ir.actions.act_window">

        <field name="name">Students</field>

        <field name="res_model">student.student</field>

        <field name="view_mode">list,form</field>

    </record>

</odoo>
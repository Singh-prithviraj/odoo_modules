<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- Course List View -->
    <record id="student_course_list_view" model="ir.ui.view">
        <field name="name">student.course.list</field>
        <field name="model">student.course</field>
        <field name="arch" type="xml">

            <list>
                <field name="name"/>
                <field name="duration"/>
            </list>

        </field>
    </record>


    <!-- Course Form View -->
    <record id="student_course_form_view" model="ir.ui.view">
        <field name="name">student.course.form</field>
        <field name="model">student.course</field>
        <field name="arch" type="xml">

            <form>

                <sheet>

                    <group>

                        <field name="name"/>
                        <field name="duration"/>
                        <field name="description"/>

                    </group>


                    <notebook>

                        <page string="Students">

                            <field name="student_ids">

                                <list editable="bottom">

                                    <field name="name"/>
                                    <field name="email"/>
                                    <field name="phone"/>
                                    <field name="age"/>
                                    <field name="gender"/>

                                </list>

                            </field>

                        </page>

                    </notebook>

                </sheet>

            </form>

        </field>
    </record>


    <!-- Course Action -->
    <record id="student_course_action" model="ir.actions.act_window">

        <field name="name">Courses</field>

        <field name="res_model">student.course</field>

        <field name="view_mode">list,form</field>

    </record>

</odoo>